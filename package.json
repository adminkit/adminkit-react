{
  "name": "adminkit-react",
  "version": "4.1.0",
  "description": "AdminKit - Free React Admin Template with Bootstrap 5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check . && tsc --noEmit && node scripts/stats.mjs --check",
    "format": "prettier --write .",
    "stats": "node scripts/stats.mjs",
    "test": "playwright test",
    "test:install": "playwright install chromium"
  },
  "keywords": [
    "react",
    "vite",
    "react-router",
    "bootstrap",
    "bootstrap 5",
    "admin",
    "dashboard",
    "template",
    "typescript"
  ],
  "homepage": "https://adminkit.io/",
  "bugs": {
    "url": "https://github.com/adminkit/adminkit-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminkit/adminkit-react.git"
  },
  "license": "MIT",
  "author": "Paul Laros <support@adminkit.io>",
  "private": true,
  "type": "module",
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@fontsource/inter": "5.3.0",
    "bootstrap": "5.3.8",
    "chart.js": "4.6.1",
    "jsvectormap": "1.7.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "simplebar-react": "3.3.2",
    "vanilla-calendar-pro": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "sass": "1.108.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "lefthook": true
  },
  "adminkit": {
    "edition": "free",
    "framework": "react"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "glob": "14.0.3"
  }
}
